{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diana-flagstaff",
  // Wraps .open-next/worker.js; supplier refreshes run in GitHub Actions.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "dianaflagstaff.com", "custom_domain": true },
    { "pattern": "www.dianaflagstaff.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Image requests must pass through protection before static assets are served.
    "run_worker_first": ["/art", "/art/*", "/products/*", "/yarn-images/*", "/yarn-swatches/*", "/about", "/about/*", "/shop", "/shop/*", "/", "/_next/image*"]
  },
  "ratelimits": [
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "96081030",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ORDER_EMAIL_ENABLED": "false",
    // Set MAKER_PASSWORD and RESEND_API_KEY using wrangler secret put.
    // ORDER_EMAIL_FROM must use a verified Resend sending domain.
    // CRON_SECRET: set this in the Cloudflare dashboard (Workers → Settings → Variables)
    // to secure the /api/cron/* endpoints. Required for the Mac → site Charisma stock push.
  },
  "d1_databases": [
    {
      "binding": "EMAIL_DB",
      "database_name": "diana-order-emails",
      "database_id": "49069767-f2cd-409a-86f0-3c9373acdbea",
      "migrations_dir": "migrations/email"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ORDERS_KV",
      "id": "acce3fd056324a398d6d079fbb4774b4",
      "preview_id": "c18e85c4493d499090ba650523cc91cb"
    },
    {
      // Shared stock cache for Bobbiny, Charisma, and Bernat; supplier keys stay separate.
      "binding": "BOBBINY_STOCK",
      "id": "191c98d028e34244b24344c5c7fdce75",
      "preview_id": "15edd3bb46bf49a2beb5d95658c2240c"
    }
  ],
  "triggers": {
    // Supplier stock now refreshes through GitHub Actions, once per supplier.
    "crons": []
  }
}
